{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": "./src",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["./src"]
}
