# /etc/scriptorium/config.env — installed 0600, read by systemd.
#
# Copy this example only when postinst has not seeded it, then replace
# every CHANGE_ME value. Never commit a real secret. Environment
# variables override this file.
DATABASE_URL=postgresql+asyncpg://scriptorium:CHANGE_ME@127.0.0.1:5432/scriptorium
# Required, no default. Generate once:
#   /opt/scriptorium/runtime/python-3.14/bin/python3.14 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
SCRIPTORIUM_COOKIE_SECURE=true

# Redis: limiter uses logical DB 1; Celery broker uses DB 0.
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Build dispatch: production uses the worker; dev/CI may set inline.
SC_BUILD_DISPATCH=celery
SC_BUILD_PYTHON=/opt/scriptorium/build-venv/bin/python
SC_ARTIFACT_ROOT=/var/lib/scriptorium/artifacts
SC_BUILD_ROOT=/var/lib/scriptorium/builds
SC_MEDIA_ROOT=/var/lib/scriptorium/media

# Backup dispatch: production uses the worker; dev/CI may set inline.
# Full archives live outside the web root and are deleted after download
# or expiry (0039). Limits are optional overrides of the approved defaults.
SC_BACKUP_DISPATCH=celery
SC_BACKUP_ROOT=/var/lib/scriptorium/backups
# SC_BACKUP_DOWNLOAD_TTL_SECONDS=900
# SC_BACKUP_MAX_ARCHIVE_BYTES=8589934592
# SC_BACKUP_MAX_EXPANDED_BYTES=17179869184
# SC_BACKUP_MAX_ENTRIES=200000
# SC_BACKUP_MAX_ENTRY_BYTES=536870912

SC_SPHINX_CPU_SECONDS=600
SC_SPHINX_MEMORY_BYTES=1610612736
SC_SPHINX_MAX_FILE_BYTES=536870912
SC_SPHINX_TIMEOUT_S=900

# Optional login limiter overrides (0019 defaults: 5 failures / 900 s).
# SCRIPTORIUM_RATELIMIT_LOGIN_MAX=5
# SCRIPTORIUM_RATELIMIT_LOGIN_WINDOW_S=900
