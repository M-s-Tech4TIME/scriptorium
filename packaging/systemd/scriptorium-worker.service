[Unit]
Description=Scriptorium worker (Celery build queue)
Requires=redis.service
After=network.target postgresql.service redis.service
[Service]
User=scriptorium
Group=scriptorium
WorkingDirectory=/opt/scriptorium/backend
EnvironmentFile=/etc/scriptorium/config.env
ExecStart=/opt/scriptorium/backend/.venv/bin/celery -A app.worker worker --loglevel=INFO --concurrency=2
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
