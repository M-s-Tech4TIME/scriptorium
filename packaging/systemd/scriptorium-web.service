[Unit]
Description=Scriptorium web (FastAPI gunicorn+uvicorn)
Requires=scriptorium-redis.service
After=network.target postgresql.service scriptorium-redis.service
[Service]
User=scriptorium
Group=scriptorium
WorkingDirectory=/opt/scriptorium/backend
EnvironmentFile=/etc/scriptorium/config.env
ExecStart=/opt/scriptorium/backend/.venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker --bind 127.0.0.1:8470 --workers 3
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
